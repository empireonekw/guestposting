MONGO_URI=
JWT_SECRET=
# Public URL of the site, used for links inside emails
FRONTEND_URL=https://guestposting.live
# Gmail account + app password used to send emails
MY_EMAIL=
EMAIL_PASSWORD=


# Free automatic site data. DR comes from Ahrefs' free endpoint: create a free
# Ahrefs account, then Account settings → API keys. Leave empty to turn DR
# look-ups off (sellers type DR, our team checks it).
AHREFS_API_KEY=
# Where `npm run build:authority` writes the GP Authority index (Common Crawl).
# Defaults to ./data/authority
AUTHORITY_INDEX_DIR=
